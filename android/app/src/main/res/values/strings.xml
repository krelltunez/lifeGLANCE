<resources>
    <string name="app_name">lifeGLANCE</string>
    <string name="title_activity_main">lifeGLANCE</string>
    <string name="package_name">com.lifeglance.app</string>
    <string name="custom_url_scheme">com.lifeglance.app</string>

    <string name="widget_next_milestone_label">Next milestone</string>
    <string name="widget_next_milestone_description">Your next upcoming milestone, with a live countdown.</string>

    <string name="widget_today_label">Today</string>
    <string name="widget_today_description">Today\'s date and your age, with recent and upcoming milestones at larger sizes.</string>

    <string name="widget_current_chapter_label">Current chapter</string>
    <string name="widget_current_chapter_description">The chapter you\'re in now: how far along you are and milestones passed.</string>

    <string name="widget_on_this_day_label">On this day</string>
    <string name="widget_on_this_day_description">Milestones from today\'s date in past years.</string>

    <string name="widget_stats_label">Milestones</string>
    <string name="widget_stats_description">Your milestone totals: past, ahead, this year, and your age.</string>

    <string name="widget_quick_add_label">Add milestone</string>
    <string name="widget_quick_add_description">A one-tap shortcut to add a new milestone.</string>

    <!-- Quick Settings tile + app shortcut (both open the add-milestone sheet) -->
    <string name="tile_add_milestone_label">Add milestone</string>
    <string name="shortcut_add_short">Add milestone</string>
    <string name="shortcut_add_long">Add a new milestone</string>
    <string name="shortcut_search_short">Search</string>
    <string name="shortcut_search_long">Search milestones</string>

    <string name="widget_pin_amber_label">Countdown · amber</string>
    <string name="widget_pin_rose_label">Countdown · rose</string>
    <string name="widget_pin_teal_label">Countdown · teal</string>
    <string name="widget_pin_blue_label">Countdown · blue</string>
    <string name="widget_pinned_description">A countdown to the milestone pinned to this color slot in the app.</string>

    <!-- Rendered inside the Glance widgets (widget/*.kt). The EYEBROW strings
         are display-form headers: translations supply their own casing, since
         uppercasing is locale-sensitive and Chinese has no case at all. -->
    <string name="widget_eyebrow_next">NEXT</string>
    <string name="widget_eyebrow_today">TODAY</string>
    <string name="widget_eyebrow_chapter">CHAPTER</string>
    <string name="widget_eyebrow_on_this_day">ON THIS DAY</string>
    <string name="widget_eyebrow_pinned">PINNED</string>
    <string name="widget_eyebrow_milestones">MILESTONES</string>
    <string name="widget_no_upcoming">No upcoming milestones</string>
    <string name="widget_no_active_chapter">No active chapter</string>
    <string name="widget_nothing_on_this_day">Nothing from today in past years</string>
    <string name="widget_new_milestone">new milestone</string>
    <string name="widget_pin_hint">Pin a milestone to the %1$s slot in the app</string>
    <string name="widget_last_passed">last · %1$s (%2$s)</string>
    <string name="widget_milestones_count">%1$d/%2$d milestones</string>
    <!-- "2 yrs, 3 mo in" — how far into the current chapter you are. -->
    <string name="widget_chapter_elapsed">%1$s in</string>
    <string name="widget_more_count">+%1$d more</string>
    <string name="widget_past_ahead">%1$d past · %2$d ahead</string>
    <string name="widget_this_year_count">%1$d this year</string>
    <string name="widget_age">age %1$d</string>
    <string name="widget_context_next">next</string>
    <string name="widget_context_last">last</string>
    <string name="widget_context_chapter">chapter</string>

    <!-- Relative-time pieces assembled by WidgetData.relativeLabel()/durationWords():
         a duration body ("2 yrs, 1 mo") wrapped in a direction pattern. -->
    <string name="widget_rel_today">today</string>
    <string name="widget_just_started">just started</string>
    <string name="widget_rel_future">in %1$s</string>
    <string name="widget_rel_past">%1$s ago</string>
    <!-- Joins the years and months parts; Chinese joins without a comma. -->
    <string name="widget_dur_join">%1$s, %2$s</string>
    <plurals name="widget_dur_months">
        <item quantity="one">%1$d mo</item>
        <item quantity="other">%1$d mo</item>
    </plurals>
    <plurals name="widget_dur_years">
        <item quantity="one">%1$d yr</item>
        <item quantity="other">%1$d yrs</item>
    </plurals>
    <plurals name="widget_dur_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
    <plurals name="widget_years_old">
        <item quantity="one">%1$d year old</item>
        <item quantity="other">%1$d years old</item>
    </plurals>
    <plurals name="widget_years_ago">
        <item quantity="one">%1$d year ago</item>
        <item quantity="other">%1$d years ago</item>
    </plurals>

    <!-- Display names for the countdown pin slots; the ids stay untranslated. -->
    <string name="slot_amber">amber</string>
    <string name="slot_rose">rose</string>
    <string name="slot_teal">teal</string>
    <string name="slot_blue">blue</string>
</resources>
