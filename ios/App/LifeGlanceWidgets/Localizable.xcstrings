    "The chapter you're in now: how far along you are and milestones passed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Kapitel, in dem du gerade bist: wie weit du bist und wie viele Meilensteine vergangen sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El capítulo en el que estás: cuánto llevas y los hitos pasados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chapitre où vous êtes : votre progression et les jalons passés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il capitolo in cui sei ora: a che punto sei e i traguardi passati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O capítulo em que você está agora: quanto já avançou e os marcos passados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O capítulo em que está agora: quanto já avançou e os marcos passados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您现在所处的章节：已行进多远，以及走过的里程碑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您現在身處的章節：已走了多遠，以及走過的里程碑。"
          }
        }
      }
    },
