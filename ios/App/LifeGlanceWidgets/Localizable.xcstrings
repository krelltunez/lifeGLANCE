    "Your milestone totals: past, ahead, this year, and your age.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Meilenstein-Zahlen: vergangen, bevorstehend, dieses Jahr und dein Alter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus totales de hitos: pasados, próximos, este año y tu edad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos totaux de jalons : passés, à venir, cette année et votre âge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi totali: passati, in arrivo, quest'anno e la tua età."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus totais de marcos: passados, futuros, este ano e sua idade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus totais de marcos: passados, futuros, este ano e a sua idade."
          }
        },
