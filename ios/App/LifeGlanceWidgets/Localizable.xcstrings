    "Your next upcoming milestone, with a live countdown.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein nächster bevorstehender Meilenstein, mit Live-Countdown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu próximo hito, con cuenta atrás en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre prochain jalon, avec compte à rebours en direct."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo prossimo traguardo, con conto alla rovescia dal vivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu próximo marco, com contagem regressiva ao vivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu próximo marco, com contagem decrescente ao vivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的下一个里程碑，附实时倒计时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的下一個里程碑，附即時倒數。"
          }
        }
      }
    },
