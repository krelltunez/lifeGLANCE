    "Today's date and your age, with recent and upcoming milestones at larger sizes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das heutige Datum und dein Alter, in größeren Größen mit letzten und bevorstehenden Meilensteinen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de hoy y tu edad; en tamaños grandes, también hitos recientes y próximos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date du jour et votre âge, avec les jalons récents et à venir en grande taille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data di oggi e la tua età; nelle dimensioni più grandi anche i traguardi recenti e in arrivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data de hoje e sua idade; nos tamanhos maiores, também marcos recentes e próximos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A data de hoje e a sua idade; nos tamanhos maiores, também marcos recentes e próximos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的日期与您的年龄；较大尺寸下还会显示最近与即将到来的里程碑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今日的日期與您的年齡；較大尺寸下還會顯示最近與即將到來的里程碑。"
          }
        }
      }
    },
