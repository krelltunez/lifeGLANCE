    "%@\n\nIt'll be waiting as a new milestone next time you open the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nEs wartet als neuer Meilenstein auf dich, wenn du die App das nächste Mal öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nTe estará esperando como un nuevo hito la próxima vez que abras la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nIl vous attendra comme nouveau jalon à la prochaine ouverture de l'application."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nTi aspetterà come nuovo traguardo alla prossima apertura dell’app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nEle estará esperando como um novo marco na próxima vez que você abrir o aplicativo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nEstará à sua espera como um novo marco da próxima vez que abrir a aplicação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n下次打开应用时，它会作为新里程碑等着您。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n下次開啟應用程式時，它會作為新里程碑等著您。"
          }
        }
      }
    },
    "Nothing to save": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu speichern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que guardar"
          }
        },
        "fr": {
