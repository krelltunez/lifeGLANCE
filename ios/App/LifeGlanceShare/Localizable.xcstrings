          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可儲存的內容"
          }
        }
      }
    },
    "This item didn't contain any text or link lifeGLANCE could use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Element enthielt keinen Text und keinen Link, den lifeGLANCE verwenden könnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento no contenía texto ni enlaces que lifeGLANCE pudiera usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément ne contenait ni texte ni lien que lifeGLANCE puisse utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento non conteneva testo o link utilizzabili da lifeGLANCE."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item não continha texto nem link que o lifeGLANCE pudesse usar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este item não continha texto nem ligação que o lifeGLANCE pudesse usar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此内容不包含 lifeGLANCE 可用的文本或链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此內容不包含 lifeGLANCE 可用的文字或連結。"
          }
        }
      }
    }
