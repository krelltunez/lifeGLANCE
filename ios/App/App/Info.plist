<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>lifeGLANCE</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export compliance: false because the app's encryption uses only
	     standard, internationally-recognized algorithms (AES-256-GCM,
	     PBKDF2-SHA-256, HMAC-SHA-256) for end-to-end vault sync and backup
	     (@glance-apps/sync) in a mass-market app, which qualifies for the EAR
	     exemption. This makes App Store Connect skip the export-compliance
	     prompt on every build. Matches dayGLANCE, which settled on the same
	     answer for the same sync stack (dayglance-ios/project.yml).
	     Separately, file the annual BIS self-classification report. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.lifeglance.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lifeglance</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Media attach goes through <input type="file"> on iOS: the native
	     Photo Picker / SAF path in src/native/mediaPicker.js is Android-only, so
	     AddMilestoneSheet.jsx falls through to the hidden inputs
	     (accept="image/*" and accept="audio/*,video/*"). WKWebView answers those
	     with an action sheet that includes "Take Photo or Video", and that
	     capture runs IN THIS PROCESS — so without these keys iOS terminates the
	     app the moment the user picks it. Not reproducible in CI (the shell is
	     not compiled) or in the Simulator (no camera); guarded by
	     src/native/mediaCaptureIosParity.test.js.
	     Camera and microphone are required by that path. The photo-library key is
	     defensive: current iOS serves the library through an out-of-process
	     picker that needs no string, but older or variant WebKit paths have used an
	     in-process picker that does. -->
	<key>NSCameraUsageDescription</key>
	<string>lifeGLANCE uses the camera only when you choose Take Photo or Video while attaching media to a milestone. Your photos and videos stay on your device.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>lifeGLANCE uses the microphone only when you record a video to attach to a milestone. Your recordings stay on your device.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>lifeGLANCE opens your photo library only when you pick a photo or video to attach to a milestone, and reads just the item you choose.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<!-- The UIScene lifecycle: required for apps built with the iOS 27 SDK,
	     which are terminated at launch without it. The scene loads Main
	     (MainViewController), so there is no UIMainStoryboardFile. One scene
	     only: the plugins assume a single bridge. See SceneDelegate.swift. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
